{
  "name": "@prometeu/design-system",
  "version": "0.2.0",
  "description": "Componentes, comportamento, acessibilidade e adaptadores do Design System da Prometeu.",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "tokens.css",
    "components.css",
    "prometeu.svg",
    "index.html",
    "README.md",
    "dist",
    "src",
    "rails",
    "build.mjs",
    "tsconfig.json",
    "gallery.js"
  ],
  "exports": {
    "./tokens.css": "./tokens.css",
    "./components.css": "./components.css",
    "./prometeu.svg": "./prometeu.svg",
    "./gallery": "./index.html",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./menu": {
      "types": "./dist/menu.d.ts",
      "import": "./dist/menu.js"
    },
    "./browser": "./dist/browser.js",
    "./rails": "./rails/prometeu_design_system.rb"
  },
  "sideEffects": [
    "*.css",
    "./dist/browser.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
