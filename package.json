{
  "name": "prometheus",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p relay && vite build",
    "app": "sh scripts/app.sh",
    "build:app": "tauri build",
    "tauri": "tauri",
    "test": "vitest run && cd src-tauri && cargo test --workspace",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "relay:dev": "wrangler dev --config relay/wrangler.toml --port 8787",
    "relay:deploy": "wrangler deploy --config relay/wrangler.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "marked": "^18.0.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@tauri-apps/cli": "^2",
    "git-cliff": "^2.13.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.126.0"
  }
}
