{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prometheus",
  "mainBinaryName": "Prometheus",
  "version": "0.1.5",
  "identifier": "dev.prometheus.app",
  "build": {
    "beforeDevCommand": "sh scripts/sidecar.sh && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "sh scripts/sidecar.sh && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prometheus",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 21.5
        },
        "theme": "Dark",
        "backgroundColor": "#141110"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/prometheus-hook"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/gbrancaglione/prometheus-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxMjM3N0I1MDk2NzJFMUYKUldRZkxtY0p0WGNqWWFrVEl5Ujh0MGI4dmpuQk1HeWVNZHlLOEwyRFYzVlJ5VmNVQUE0RzRFY08K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
