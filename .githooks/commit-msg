#!/bin/sh
# Require Conventional Commits because git-cliff derives versions, CHANGELOG.md and release notes from
# commit messages. npm install sets core.hooksPath here; CI runs the same hook against each PR commit.
# See AGENTS.md.
set -eu

MSG=$(grep -v '^#' "$1" | sed -n '/./{p;q;}')
case "$MSG" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

TYPES='feat|fix|perf|refactor|docs|test|chore|ci|build|style|revert'
if ! printf '%s\n' "$MSG" | grep -Eq "^($TYPES)(\([^)]+\))?!?: [^ ]"; then
  cat >&2 <<END
commit rejected — the first line must be "type(scope): description":

  $MSG

types: $(printf '%s' "$TYPES" | tr '|' ' ')
e.g.:  feat(launcher): show effort and model in the footer
       fix(board): dragging a card between columns works again
       chore: update dependencies

Commits are written in English. The description of feat, fix and perf becomes a
changelog line for whoever uses the app: say what the person sees, not what the
code does. See AGENTS.md.
END
  exit 1
fi
